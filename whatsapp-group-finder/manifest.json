{
  "manifest_version": 3,
  "name": "WhatsApp Group Finder (Google 100 Results)",
  "version": "1.0.0",
  "description": "Runs your Google searches, loads 100 results per search, and extracts every chat.whatsapp.com group link.",
  "permissions": ["storage", "tabs", "notifications"],
  "host_permissions": ["https://www.google.com/*", "https://www.google.co.in/*"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [{
    "matches": ["https://www.google.com/search*", "https://www.google.co.in/search*", "https://www.google.com/sorry/*", "https://www.google.co.in/sorry/*"],
    "js": ["content-script.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_popup": "popup/popup.html", "default_title": "WhatsApp Group Finder" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
