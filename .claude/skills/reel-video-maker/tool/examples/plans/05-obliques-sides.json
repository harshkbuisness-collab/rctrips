     "type": "image",
     "asset": "hero_reverse_crunch",
     "shadow": true,
     "enter": "squash",
     "width": 0.92,
     "y": 0.56
    },
    {
     "type": "callout",
     "text": "ELBOW TO KNEE",
     "anchor": "knees",
     "x": 0.5,
     "y": 0.36,
     "at": "opposite knee",
     "until": "fully extend"
