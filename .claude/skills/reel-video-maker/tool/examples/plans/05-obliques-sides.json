{
 "title": "Obliques: sides of abs",
 "theme": "effortless",
 "captions": {
  "mode": "word",
  "keywords": [
   "abs",
   "flat",
   "plain",
   "missing",
   "sides",
   "wrong",
   "wider",
   "obliques",
   "sharper",
   "heavy",
   "straight",
   "reps"
  ]
 },
 "scenes": [
  {
   "id": "hook",
   "start": "start",
   "backdrop": "halftone",
   "shakes": [
    {
     "at": "still looks flat"
    },
    {
     "at": "look wider"
    }
   ],
   "layers": [
    {
     "type": "image",
     "asset": "hero_point_viewer",
     "shadow": true,
     "until": "your stomach",
     "enter": "cut"
    },
    {
     "type": "image",
     "asset": "hero_point_down",
     "shadow": true,
     "at": "your stomach",
     "until": "still looks flat",
     "enter": "punch"
    },
    {
     "type": "kinetic",
     "lines": [
      {
       "text": "TRAINING ABS?",
       "at": "start"
      },
      {
       "text": "STILL FLAT?",
       "at": "still looks flat",
       "look": "box"
      }
     ],
     "until": "You're missing"
    },
    {
     "type": "image",
     "asset": "hero_what",
     "shadow": true,
     "at": "still looks flat",
     "until": "You're missing",
     "enter": "punch"
    },
    {
     "type": "highlight",
     "anchor": "abs",
     "at": "flat and plain",
     "until": "You're missing",
     "color": "#E3262E"
    },
    {
     "type": "image",
     "asset": "hero_detective",
     "shadow": true,
