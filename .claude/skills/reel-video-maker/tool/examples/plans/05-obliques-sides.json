    {
     "type": "arrow",
     "anchor": "feet",
     "pointing": "right",
     "color": "#2FD94E",
     "at": "fully extend",
     "until": "Twenty reps"
    },
    {
     "type": "highlight",
     "anchor": "abs",
     "at": "fully extend",
     "until": "Twenty reps",
     "color": "#2FD94E"
    },
    {
     "type": "ring",
     "count": {
      "from": 0,
      "to": 20
     },
     "label": "20 reps",
     "y": 0.31,
     "duration": 1.5,
     "at": "Twenty reps"
    }
   ]
  },
  {
   "id": "plan",
